<% layout("/layouts/boilerplate") %>

<style>
  .show-img {
    height: 400px;
    object-fit: cover;
  }
  .btn-brand {
    background-color: #fe424d;
    color: #fff;
  }
  .btn-brand:hover {
    background-color: #e0343f;
    color: #fff;
  }
</style>

<div class="container my-4" style="max-width: 960px;">
  <!-- Title & Location -->
  <h2 class="fw-bold mb-1"><%= listing.title %></h2>
  <p class="text-muted mb-3">
    <i class="fa-solid fa-location-dot text-danger me-1"></i>
    <%= listing.location %>, <%= listing.country %>
  </p>

  <!-- Hero Image -->
  <img src="<%= listing.image.url %>" class="w-100 rounded-4 show-img mb-4 shadow-sm" alt="listing_image" />

  <div class="row g-4">
    <!-- Left Column: Details & Reviews -->
    <div class="col-md-8">
      <h5 class="fw-semibold">Hosted by <%= listing.owner.username %></h5>
      <p class="text-secondary mt-2 mb-4"><%= listing.description %></p>

      <hr />

      <!-- Leave a Review -->
      <% if(currUser) { %>
        <h4 class="fw-bold mb-3">Leave a Review</h4>
        <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation mb-4">
          <div class="mb-3">
            <label for="rating" class="form-label fw-semibold">Rating</label>
            <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range" />
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label fw-semibold">Comment</label>
            <textarea id="comment" name="review[Comment]" rows="3" class="form-control" required></textarea>
          </div>
          <button class="btn btn-brand px-4">Submit</button>
        </form>
        <hr />
      <% } %>

      <!-- All Reviews -->
      <h4 class="fw-bold mb-3">All Reviews (<%= listing.reviews.length %>)</h4>
      <div class="row g-3">
        <% for(let review of listing.reviews) { %>
          <div class="col-sm-6">
            <div class="card h-100 border rounded-3 shadow-sm p-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0">@<%= review.author.username %></h6>
                <span class="text-danger fw-semibold"><%= review.rating %> ★</span>
              </div>
              <p class="text-secondary small mb-3"><%= review.Comment %></p>
              <% if(currUser && review.author._id.equals(currUser._id)) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-auto">
                  <button class="btn btn-sm btn-outline-dark">Delete</button>
                </form>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: Price & Owner Actions -->
    <div class="col-md-4">
      <div class="card border rounded-4 shadow-sm p-4 sticky-top" style="top: 100px;">
        <h4 class="fw-bold mb-3">
          &#8377;<%= listing.price.toLocaleString("en-IN") %>
          <span class="fs-6 fw-normal text-muted">/ night</span>
        </h4>

        <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
          <div class="d-flex gap-2">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark flex-fill">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="flex-fill">
              <button class="btn btn-outline-danger w-100">Delete</button>
            </form>
          </div>
        <% } else { %>
          <button class="btn btn-brand w-100 py-2 fw-semibold">Reserve</button>
        <% } %>
      </div>
    </div>
  </div>
</div>